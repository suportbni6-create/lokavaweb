rules_version = '2';
// LOKAVA: default-deny.
// Semua TULIS dan semua BACA data publik terjadi di server (Admin SDK). Klien hanya boleh
// membaca dokumen miliknya sendiri; tidak ada penulisan dari klien sama sekali.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false; // role/status tidak bisa diubah dari klien
    }

    match /businesses/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }
    match /products/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }
    match /subscriptions/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }
    match /promotions/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false;
    }
    match /transactions/{id} {
      allow read: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow write: if false; // nominal, status, persetujuan hanya dari server
    }
    match /deletionRequests/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Tidak ada akses klien: konfigurasi, rahasia, audit, dan data yang dibaca lewat server.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
