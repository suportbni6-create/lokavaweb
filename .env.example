# ===== Firebase (publik, aman di browser) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Firebase Admin (RAHASIA, hanya server) =====
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Tempel private key dengan \n literal, dibungkus tanda kutip ganda
FIREBASE_ADMIN_PRIVATE_KEY=

# ===== Cloudinary =====
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opsional. Aplikasi memakai signed upload, preset TIDAK diperlukan.
CLOUDINARY_UPLOAD_PRESET=

# ===== Aplikasi =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Opsional: URL tile peta penyedia produksi, mis. https://tile.example/{z}/{x}/{y}.png (default: server OSM publik, hanya untuk trafik kecil)
# 32 byte acak dalam hex (64 karakter). Buat: openssl rand -hex 32
APP_ENCRYPTION_KEY=
# Rahasia acak untuk memanggil /api/cron/maintenance. Buat: openssl rand -hex 24
CRON_SECRET=

# ===== Telegram =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_CHAT_ID=
NEXT_PUBLIC_MAP_TILE_URL=
